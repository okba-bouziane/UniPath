# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Optional: override the default model for the chosen provider
# Anthropic default: claude-haiku-5-5   |   OpenAI default: gpt-4o-mini
# LLM_MODEL=

# Set the key for the provider you chose
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: where the Chroma DB is stored (default: ./chroma_db)
# CHROMA_DIR=chroma_db
