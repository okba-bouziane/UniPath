# Which LLM provider to use: "anthropic", "openai" or "google" (Gemini)
LLM_PROVIDER=anthropic

# Optional: override the default model for the chosen provider
# Defaults: anthropic -> claude-haiku-5-5 | openai -> gpt-4o-mini | google -> gemini-3.1-flash-lite
# LLM_MODEL=

# Set the key for the provider you chose
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint used by the openai provider (e.g. Groq)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_API_KEY=

# Optional: where the Chroma DB is stored (default: ./chroma_db)
# CHROMA_DIR=chroma_db
